{
  "name": "keyboard-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "a seed-driven generative instrument — every keystroke is light and sound",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
